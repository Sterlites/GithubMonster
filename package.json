{
  "name": "githubmonster",
  "version": "1.0.0",
  "description": "AI-powered repository analysis tools",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\""
  },
  "keywords": [
    "github",
    "ai",
    "analysis",
    "repository"
  ],
  "author": "GithubMonster",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@google/generative-ai": "^0.1.3",
    "@octokit/rest": "^20.0.0",
    "axios": "^1.6.0",
    "express-rate-limit": "^6.11.2",
    "ioredis": "^5.3.0",
    "joi": "^17.11.0",
    "next": "^14.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.11.0",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.20.0",
    "tree-sitter": "^0.20.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/redis": "^4.0.10",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "typescript": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "pages/api/**/*.js",
      "utils/**/*.js",
      "services/**/*.js",
      "!**/*.test.js",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(node-cache)/)"
    ]
  }
}
